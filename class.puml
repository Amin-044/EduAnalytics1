@startuml EduAnalytics Class Diagram
skinparam classAttributeIconSize 0
skinparam linetype ortho
title EduAnalytics - Class Diagram

' ================= Entities =================

class User {
  - id : int
  - name : String
  - email : String
  - password : String
  - role : String <<admin, user>>
  - created_at : DateTime
  + login(email, password) : Session
  + signup(name, email, password) : User
  + updateRole(userId, role) : void
}

class Student {
  - id : int
  - student_id : String <<unique, e.g. BCA001>>
  - name : String
  - email : String
  - phone : String
  - course : String
  - semester : int
  - created_at : DateTime
  + getAverageMarks() : float
  + getAverageAttendance() : float
  + getPerformanceStatus() : String
}

class Subject {
  - id : int
  - code : String <<unique, e.g. BCA601>>
  - name : String
}

class Marks {
  - id : int
  - student_id : int <<FK>>
  - subject_id : int <<FK>>
  - internal_1 : float
  - internal_2 : float
  - assignment : float
  + getAverage() : float
}

class Attendance {
  - id : int
  - student_id : int <<FK>>
  - subject_id : int <<FK>>
  - total_classes : int
  - present_classes : int
  + getPercentage() : float
  + getStatus() : String <<Good / Low>>
}

' ============ Services / Controllers ============

class AuthService {
  + login() : JSON
  + signup() : JSON
  + getUsers() : JSON
  + updateUserRole() : JSON
  + deleteUser() : JSON
}

class StudentService {
  + getStudents() : JSON
  + insertStudent() : JSON
  + updateStudent() : JSON
  + deleteStudent() : JSON
  + getStudentAnalytics(studentId) : JSON
}

class AcademicService {
  + getSubjects() : JSON
  + getMarks() : JSON
  + getAttendance() : JSON
  + getDashboard() : JSON
  + manageMarks() : JSON
  + manageAttendance() : JSON
}

class ResultPdfGenerator {
  + generate(student, analytics) : PDF
}

' ================= Relationships =================

' Marks is an association class between Student and Subject
Student "1" -- "0..*" Marks : has >
Subject "1" -- "0..*" Marks : graded in >

' Attendance is an association class between Student and Subject
Student "1" -- "0..*" Attendance : records >
Subject "1" -- "0..*" Attendance : tracked in >

' Admin/User manages domain objects (dependency, not FK)
User ..> Student : manages
User ..> Subject : manages
User ..> Marks : manages
User ..> Attendance : manages

' Services operate on entities
AuthService ..> User : CRUD
StudentService ..> Student : CRUD
StudentService ..> Marks : reads
StudentService ..> Attendance : reads
AcademicService ..> Subject : CRUD
AcademicService ..> Marks : CRUD
AcademicService ..> Attendance : CRUD
ResultPdfGenerator ..> Student : reads
ResultPdfGenerator ..> Marks : reads
ResultPdfGenerator ..> Attendance : reads

note right of Marks
  average = (internal_1
   + internal_2
   + assignment) / 3
  FK ON DELETE CASCADE
end note

note right of Attendance
  percentage =
  present_classes /
  total_classes * 100
  FK ON DELETE CASCADE
end note

note bottom of StudentService
  getStudentAnalytics joins
  subjects LEFT JOIN marks
  LEFT JOIN attendance,
  computes averageMarks,
  averageAttendance,
  performance, attendanceStatus
end note

@enduml
