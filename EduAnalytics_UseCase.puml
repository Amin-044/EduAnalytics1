@startuml EduAnalytics_UseCase_Diagram
title EduAnalytics - Student Performance Analytics System\nUse Case Diagram

left to right direction

actor "Admin" as admin
actor "User" as user

rectangle "EduAnalytics System" {
  ' Common use cases
  usecase "Sign Up" as UC1
  usecase "Login" as UC2
  usecase "Validate Credentials" as UC3
  usecase "Logout" as UC4
  
  ' Admin use cases
  usecase "Manage Students" as UC5
  usecase "Manage Subjects" as UC6
  usecase "Manage Marks" as UC7
  usecase "Manage Attendance" as UC8
  usecase "Manage Users" as UC9
  usecase "View Dashboard" as UC10
  usecase "View Student Analytics" as UC11
  usecase "View Results" as UC12
  usecase "Download Result PDF" as UC13
}

' User relationships
user --> UC1
user --> UC2
user --> UC4
user --> UC10
user --> UC11
user --> UC12
user --> UC13

' Admin relationships
admin --> UC1
admin --> UC2
admin --> UC4
admin --> UC5
admin --> UC6
admin --> UC7
admin --> UC8
admin --> UC9
admin --> UC10
admin --> UC11
admin --> UC12
admin --> UC13

' Include/extend relationships
UC2 ..> UC3 : <<include>>
UC13 ..> UC12 : <<extend>>

note right of UC9
  Admin can change user roles
  and delete user accounts
end note

note right of UC13
  Generate and download
  Statement of Marks as PDF
end note

@enduml
