@startuml EduAnalytics_Class_Diagram
title EduAnalytics - Student Performance Analytics System\nClass Diagram

class User {
  +id : int
  +name : string
  +email : string
  +password : string
  +role : string
  +created_at : datetime
  +login() : boolean
  +logout() : void
}

class Student {
  +id : int
  +student_id : string
  +name : string
  +email : string
  +phone : string
  +course : string
  +semester : int
  +created_at : datetime
  +addStudent() : void
  +updateStudent() : void
  +deleteStudent() : void
  +searchStudent() : List
}

class Subject {
  +id : int
  +code : string
  +name : string
  +addSubject() : void
  +updateSubject() : void
  +deleteSubject() : void
}

class Marks {
  +id : int
  +student_id : int
  +subject_id : int
  +internal_1 : decimal
  +internal_2 : decimal
  +assignment : decimal
  +calculateAverage() : decimal
  +addMarks() : void
  +updateMarks() : void
  +deleteMarks() : void
}

class Attendance {
  +id : int
  +student_id : int
  +subject_id : int
  +total_classes : int
  +present_classes : int
  +calculatePercentage() : float
  +getStatus() : string
  +addAttendance() : void
  +updateAttendance() : void
  +deleteAttendance() : void
}

class Dashboard {
  +getKPIs() : array
  +getSubjectAverages() : array
  +getAttendanceDistribution() : array
  +getStudentAverages() : array
}

class Results {
  +getResultSheet() : array
  +calculateGrade() : string
  +checkPassFail() : boolean
  +generatePDF() : void
}

class StudentAnalytics {
  +getStudentSummary() : array
  +getSubjectWisePerformance() : array
}

User "1" -- "*" Student : manages (Admin)
Student "1" -- "*" Marks : has
Student "1" -- "*" Attendance : has
Subject "1" -- "*" Marks : awarded in
Subject "1" -- "*" Attendance : tracked for
Dashboard "1" -- "*" Student : displays
Results "1" -- "*" Student : generates for
StudentAnalytics "1" -- "*" Student : analyzes

@enduml
